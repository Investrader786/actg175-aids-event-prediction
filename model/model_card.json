{
  "project": "ACTG 175 - prediction of an AIDS-defining event or death (cid)",
  "dataset": {
    "name": "AIDS Clinical Trials Group Study 175",
    "source": "https://archive.ics.uci.edu/dataset/890/aids+clinical+trials+group+study+175",
    "rows_raw": 2139,
    "rows_used": 2139
  },
  "target": "cid",
  "positive_class": 1,
  "class_labels": {
    "0": "No event (censored)",
    "1": "AIDS event / death"
  },
  "feature_order": [
    "age",
    "wtkg",
    "karnof",
    "preanti",
    "cd40",
    "cd420",
    "cd80",
    "cd820",
    "hemo",
    "homo",
    "drugs",
    "oprior",
    "z30",
    "race",
    "gender",
    "str2",
    "symptom",
    "treat",
    "offtrt",
    "trt",
    "strat"
  ],
  "feature_groups": {
    "continuous": [
      "age",
      "wtkg",
      "karnof",
      "preanti",
      "cd40",
      "cd420",
      "cd80",
      "cd820"
    ],
    "binary": [
      "hemo",
      "homo",
      "drugs",
      "oprior",
      "z30",
      "race",
      "gender",
      "str2",
      "symptom",
      "treat",
      "offtrt"
    ],
    "nominal": [
      "trt",
      "strat"
    ]
  },
  "dropped_columns": {
    "pidnum": "patient identifier - carries no clinical signal",
    "time": "days until event or censoring - it encodes the outcome itself (target leakage)",
    "zprior": "constant - every patient has the value 1"
  },
  "metric_convention": "Binary task, positive class = 1 (AIDS event / death). Precision, Recall and F1 use average='binary' with pos_label=1; AUC is ROC-AUC on the predicted probability of class 1; MCC is the Matthews correlation coefficient.",
  "split": {
    "test_size": 0.2,
    "stratified": true,
    "seed": 5440,
    "train_rows": 1711,
    "test_rows": 428
  },
  "tuning": {
    "cv": "StratifiedKFold(n_splits=5, shuffle=True)",
    "refit_metric": "MCC"
  },
  "versions": {
    "python": "3.13.17",
    "scikit-learn": "1.7.2",
    "numpy": "2.2.6",
    "pandas": "2.3.3",
    "joblib": "1.6.0"
  },
  "models": {
    "Logistic Regression": {
      "file": "logistic_regression.joblib",
      "estimator": "LogisticRegression",
      "best_params": {
        "C": 3,
        "class_weight": "balanced"
      },
      "cv_mcc_mean": 0.3554,
      "test_metrics": {
        "Accuracy": 0.670561,
        "AUC": 0.753175,
        "Precision": 0.40107,
        "Recall": 0.721154,
        "F1": 0.515464,
        "MCC": 0.324669
      }
    },
    "Decision Tree": {
      "file": "decision_tree.joblib",
      "estimator": "DecisionTreeClassifier",
      "best_params": {
        "class_weight": "balanced",
        "criterion": "gini",
        "max_depth": 2,
        "min_samples_leaf": 1
      },
      "cv_mcc_mean": 0.366,
      "test_metrics": {
        "Accuracy": 0.726636,
        "AUC": 0.698273,
        "Precision": 0.443478,
        "Recall": 0.490385,
        "F1": 0.465753,
        "MCC": 0.283347
      }
    },
    "KNN": {
      "file": "knn.joblib",
      "estimator": "KNeighborsClassifier",
      "best_params": {
        "n_neighbors": 11,
        "p": 1,
        "weights": "distance"
      },
      "cv_mcc_mean": 0.2312,
      "test_metrics": {
        "Accuracy": 0.759346,
        "AUC": 0.60292,
        "Precision": 0.521739,
        "Recall": 0.115385,
        "F1": 0.188976,
        "MCC": 0.154883
      }
    },
    "Naive Bayes": {
      "file": "naive_bayes.joblib",
      "estimator": "GaussianNB",
      "best_params": {
        "var_smoothing": 1e-11
      },
      "cv_mcc_mean": 0.3186,
      "test_metrics": {
        "Accuracy": 0.684579,
        "AUC": 0.669308,
        "Precision": 0.371901,
        "Recall": 0.432692,
        "F1": 0.4,
        "MCC": 0.188697
      }
    },
    "Support Vector Machine": {
      "file": "svm.joblib",
      "estimator": "SVC",
      "best_params": {
        "C": 1,
        "class_weight": "balanced",
        "gamma": 0.03
      },
      "cv_mcc_mean": 0.3604,
      "test_metrics": {
        "Accuracy": 0.672897,
        "AUC": 0.730087,
        "Precision": 0.395349,
        "Recall": 0.653846,
        "F1": 0.492754,
        "MCC": 0.291182
      }
    }
  }
}